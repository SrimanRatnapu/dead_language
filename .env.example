ANTHROPIC_API_KEY=
# Which model each role runs on:
#   DL_MODEL_STRONG  thorough examiner and all three deliberating agents (undercover, counsel, case_officer)
#   DL_MODEL_TRIAGE  triage and translation (defaults to DL_MODEL_FAST when unset or empty)
#   DL_MODEL_FAST    quick examiner fallback (and the default for DL_MODEL_TRIAGE)
DL_MODEL_STRONG=claude-sonnet-5-5
DL_MODEL_FAST=claude-haiku-4-5-20251001
DL_MODEL_TRIAGE=
# Triage clears a listing only below this score (0..1) and only if the model does not flag it. Keep it low:
# a real case dropped at triage is never seen again. 0.15 comes from the s100 sweep (Haiku triage, 27 true
# positives): 27 of 27 kept at 0.15 vs 22 of 27 at 0.20. Chosen on those same 27, so re-check on new data.
DL_TRIAGE_THRESHOLD=0.15
DL_MAX_INPUT_TOKENS=6000000
DL_MAX_OUTPUT_TOKENS=600000
DL_CASE_MAX_INPUT_TOKENS=300000
DL_CASE_MAX_OUTPUT_TOKENS=30000
DL_USAGE_FILE=.usage.json
DL_DATA_DIR=../data
MARKETPLACE_MODE=local          # local | mcp
MARKETPLACE_MCP_URL=http://localhost:8100/mcp
TRANSPORT=local                 # local | agntcy
DISCOVERY=local                 # local | agntcy
SLIM_ENDPOINT=http://localhost:46357
SLIM_SHARED_SECRET=deadlang-shared-secret-change-me-32chars-min
DIRECTORY_ADDRESS=127.0.0.1:8888
NEXT_PUBLIC_API_BASE=http://localhost:8000
DL_FOLLOW_UP=1                  # 1 | 0: in a live batch, fetch a flagged listing's seller's other listings and title-word matches
